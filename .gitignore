# Build output
build/
build-*/
.cache/

# Reference PDFs — kept on disk, deliberately untracked.
# Publisher copies of Curtis '97, IMPaSTo, MoXi, Mixbox, Stam et al. The design
# docs cite them by author and year; redistributing the PDFs is not ours to do.
papers/

# Diagnostic and selftest output
np_diag.png
out-*.png
*.actual.png
selftest.png
mode_*.png

# tools/golden/run_golden.sh scratch output and failure-diagnosis artifacts.
# Reference images under tests/golden/*.png are committed; everything this
# generates alongside them on a failing run is not.
tests/golden/.work/
tests/golden/*.diff.png

# clangd/IDE compile database (regenerated by cmake -DCMAKE_EXPORT_COMPILE_COMMANDS=ON)
compile_commands.json

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp

# Recovery scratch (ADR-0008) and tile spill
*.npscratch/
