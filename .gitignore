# Build output
build/
build-*/
.cache/

# Reference PDFs — kept on disk, deliberately untracked.
# Publisher copies of Curtis '97, IMPaSTo, MoXi, Mixbox, Stam et al. The design
# docs cite them by author and year; redistributing the PDFs is not ours to do.
papers/

# Diagnostic and selftest output
np_diag.png
out-*.png
*.actual.png
selftest.png
mode_*.png

# tools/golden/run_golden.sh scratch output and failure-diagnosis artifacts.
# Reference images under tests/golden/*.png are committed; everything this
# generates alongside them on a failing run is not.
tests/golden/.work/
tests/golden/*.diff.png

# clangd/IDE compile database (regenerated by cmake -DCMAKE_EXPORT_COMPILE_COMMANDS=ON)
compile_commands.json

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp

# Recovery scratch (ADR-0008) and tile spill
*.npscratch/

# Third-party sample brush libraries, dropped in for import testing.
# Not ours to redistribute. Named individually rather than as `*.abr` so that
# a fixture this project DOES own could still be committed deliberately --
# but any Kyle Webster / Adobe pack added for testing belongs on this list
# before it is opened, not after.
runny_inkers.abr
threeOtherBrushes.abr
art_markers.abr
dry_media.abr

# Photoshop-authored `.psd` files dropped in to test io/PsdImport against a
# real Photoshop document rather than against this project's own writer.
# Artwork, not fixtures this repo owns -- and one of them is 180 MB. Listed
# by name for the same reason the brush packs above are: a `.psd` this
# project DOES own could still be committed deliberately.
Lineart4_crop.psd
Peter_confronts_a_small_monster_with_fire.psd
Testforautoflats 2.psd
