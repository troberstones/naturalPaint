<?xml version="1.0" encoding="UTF-8"?>
<!-- iOS spike (docs/ios-spike-plan.md, Phase 2), extended by the real file-
     dialog follow-up (ui/FileDialogIOS.mm). Modelled on
     icons/macos/Info.plist.in; the additions below are the ones iOS itself
     requires that macOS does not -- UIRequiredDeviceCapabilities so the
     Simulator/App Store know this needs a GPU-capable device, an empty
     UILaunchScreen so iOS 13+ skips demanding a storyboard, and
     UISupportedInterfaceOrientations because iPad defaults to allowing all
     four and this app has no orientation-specific layout of its own to
     restrict them for.

     UTExportedTypeDeclarations declares `.npaint` as a real document type
     (reverse-DNS on MACOSX_BUNDLE_GUI_IDENTIFIER, src/CMakeLists.txt) rather
     than leaving it to the dynamic `dyn.*` identifier
     `[UTType typeWithFilenameExtension:]` invents at runtime -- that dynamic
     type is enough for ui/FileDialogIOS.mm's own picker filtering (it needs
     nothing declared here at all, see that file's comment), but an
     undeclared extension is what the Files app shows as a bare
     "npaint document" with no icon and no relationship to this app.
     UIFileSharingEnabled exposes this app's own Documents/ in the Files app;
     LSSupportsOpeningDocumentsInPlace lets a provider that already has a
     `.npaint` open it here without forcing a copy. Neither
     CFBundleDocumentTypes ("Open In") nor UIDocumentBrowserViewController is
     added here -- launch-time file association is a bigger feature than
     "the Open/Save dialogs work" and out of this follow-up's scope. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
  <key>CFBundleIdentifier</key>
  <string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
  <key>CFBundleVersion</key>
  <string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
  <key>LSRequiresIPhoneOS</key>
  <true/>
  <key>UIRequiredDeviceCapabilities</key>
  <array>
    <string>arm64</string>
    <string>metal</string>
  </array>
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <key>UILaunchScreen</key>
  <dict/>
  <key>UIFileSharingEnabled</key>
  <true/>
  <key>LSSupportsOpeningDocumentsInPlace</key>
  <true/>
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>${MACOSX_BUNDLE_GUI_IDENTIFIER}.npaint-document</string>
      <key>UTTypeDescription</key>
      <string>naturalPaint document</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.content</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>npaint</string>
        </array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
