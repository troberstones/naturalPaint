{
  "name": "Default",
  "bindings": [
    { "key": "Space", "action": "toggle_pause" },
    { "key": "K", "mods": ["Cmd"], "action": "clear_canvas" },
    { "key": "N", "mods": ["Cmd"], "action": "clear_canvas" },
    { "key": "R", "mods": ["Cmd"], "action": "reload_shaders" },
    { "key": "Q", "mods": ["Cmd"], "action": "quit" },

    { "key": "=", "mods": ["Cmd"], "action": "zoom_in" },
    { "key": "-", "mods": ["Cmd"], "action": "zoom_out" },
    { "key": "0", "mods": ["Cmd"], "action": "fit_window" },
    { "key": "1", "mods": ["Cmd"], "action": "zoom_100" },
    { "key": "[", "action": "size_down" },
    { "key": "]", "action": "size_up" },
    { "key": "F", "action": "mirror_x" },
    { "key": "F", "mods": ["Shift"], "action": "mirror_y" },
    { "key": "R", "mods": ["Shift"], "action": "reset_rotation" },
    { "key": "Y", "mods": ["Cmd"], "action": "toggle_grayscale" },

    { "key": "A", "mods": ["Cmd"], "action": "select_all" },
    { "key": "D", "mods": ["Cmd"], "action": "deselect" },
    { "key": "D", "mods": ["Cmd", "Shift"], "action": "reselect" },
    { "key": "I", "mods": ["Cmd", "Shift"], "action": "invert_selection" },
    { "key": "C", "mods": ["Cmd"], "action": "copy" },
    { "key": "C", "mods": ["Cmd", "Shift"], "action": "copy_merged" },
    { "key": "X", "mods": ["Cmd"], "action": "cut" },
    { "key": "V", "mods": ["Cmd"], "action": "paste" },
    { "key": "Backspace", "action": "delete_selection" },
    { "key": "Delete", "action": "delete_selection" },

    { "key": ";", "mods": ["Cmd"], "action": "toggle_guides" },
    { "key": ";", "mods": ["Cmd", "Shift"], "action": "toggle_snapping" },
    { "key": "'", "mods": ["Cmd"], "action": "toggle_grid" },

    { "key": "F12", "action": "screenshot" }
  ]
}
