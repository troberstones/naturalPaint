{
  "name": "Default",
  "bindings": [
    { "key": "Space", "action": "toggle_pause" },
    { "key": "K", "mods": ["Cmd"], "action": "clear_canvas" },
    { "key": "N", "mods": ["Cmd"], "action": "clear_canvas" },
    { "key": "R", "mods": ["Cmd"], "action": "reload_shaders" },
    { "key": "Q", "mods": ["Cmd"], "action": "quit" },

    { "key": "=", "mods": ["Cmd"], "action": "zoom_in" },
    { "key": "-", "mods": ["Cmd"], "action": "zoom_out" },
    { "key": "0", "mods": ["Cmd"], "action": "fit_window" },
    { "key": "0", "mods": ["Cmd", "Shift"], "action": "reset_view" },
    { "key": "1", "mods": ["Cmd"], "action": "zoom_100" },
    { "key": "[", "action": "size_down" },
    { "key": "]", "action": "size_up" },
    { "key": "F", "action": "mirror_x" },
    { "key": "F", "mods": ["Shift"], "action": "mirror_y" },
    { "key": "R", "mods": ["Shift"], "action": "reset_rotation" },
    { "key": "Y", "mods": ["Cmd"], "action": "toggle_grayscale" },

    { "key": "Z", "mods": ["Cmd"], "action": "undo" },
    { "key": "T", "mods": ["Cmd"], "action": "free_transform" },
    { "key": "Z", "mods": ["Cmd", "Shift"], "action": "redo" },

    { "key": "A", "mods": ["Cmd"], "action": "select_all" },
    { "key": "D", "mods": ["Cmd"], "action": "deselect" },
    { "key": "D", "mods": ["Cmd", "Shift"], "action": "reselect" },
    { "key": "I", "mods": ["Cmd", "Shift"], "action": "invert_selection" },
    { "key": "C", "mods": ["Cmd"], "action": "copy" },
    { "key": "C", "mods": ["Cmd", "Shift"], "action": "copy_merged" },
    { "key": "X", "mods": ["Cmd"], "action": "cut" },
    { "key": "V", "mods": ["Cmd"], "action": "paste" },
    { "key": "Backspace", "action": "delete_selection" },
    { "key": "Delete", "action": "delete_selection" },

    { "key": "L", "mods": ["Cmd"], "action": "adjust_levels" },
    { "key": "M", "mods": ["Cmd"], "action": "adjust_curves" },
    { "key": "U", "mods": ["Cmd", "Shift"], "action": "adjust_desaturate" },
    { "key": "U", "mods": ["Cmd"], "action": "adjust_hue_saturation" },
    { "key": "B", "mods": ["Cmd"], "action": "adjust_color_balance" },
    { "key": "B", "mods": ["Cmd", "Shift", "Alt"], "action": "adjust_black_and_white" },
    { "key": "I", "mods": ["Cmd"], "action": "adjust_invert" },
    { "key": "L", "mods": ["Cmd", "Shift"], "action": "adjust_auto_tone" },
    { "key": "L", "mods": ["Cmd", "Shift", "Alt"], "action": "adjust_auto_contrast" },
    { "key": "B", "mods": ["Cmd", "Shift"], "action": "adjust_auto_color" },

    { "key": ";", "mods": ["Cmd"], "action": "toggle_guides" },
    { "key": ";", "mods": ["Cmd", "Shift"], "action": "toggle_snapping" },
    { "key": "'", "mods": ["Cmd"], "action": "toggle_grid" },

    { "key": "F12", "action": "screenshot" },

    { "key": "B", "action": "tool_brush" },
    { "key": "I", "action": "tool_eyedropper" },
    { "key": "M", "action": "tool_rect_marquee" },
    { "key": "M", "mods": ["Shift"], "action": "tool_ellipse_marquee" },
    { "key": "H", "action": "tool_hand" },
    { "key": "Z", "action": "tool_zoom" },
    { "key": "V", "action": "tool_move" },
    { "key": "L", "action": "tool_lasso" },
    { "key": "L", "mods": ["Shift"], "action": "tool_polygon_lasso" },
    { "key": "W", "action": "tool_magic_wand" },
    { "key": "C", "action": "tool_crop" },
    { "key": "S", "action": "tool_clone_stamp" },
    { "key": "J", "action": "tool_heal" },
    { "key": "E", "action": "tool_eraser" },
    { "key": "G", "action": "tool_gradient" },
    { "key": "G", "mods": ["Shift"], "action": "tool_paint_bucket" },
    { "key": "N", "action": "tool_smudge" },
    { "key": "O", "action": "tool_dodge" },
    { "key": "O", "mods": ["Shift"], "action": "tool_burn" },
    { "key": "P", "action": "tool_pen" },
    { "key": "P", "mods": ["Shift"], "action": "tool_curve" },
    { "key": "A", "action": "tool_path_select" },
    { "key": "T", "action": "tool_text" },

    { "key": "K", "scope": "Flats", "action": "flats_delete_fill" },
    { "key": "U", "scope": "Flats", "action": "flats_merge_pair" },
    { "key": ",", "scope": "Flats", "action": "flats_prev_gap" },
    { "key": ".", "scope": "Flats", "action": "flats_next_gap" },
    { "key": "Return", "scope": "Flats", "action": "flats_accept_gap" },
    { "key": "K", "mods": ["Cmd", "Shift"], "scope": "Flats", "action": "flats_cluster_small" }
  ]
}
