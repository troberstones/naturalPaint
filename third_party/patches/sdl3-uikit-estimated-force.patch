+// Called from touchesEstimatedPropertiesUpdated:, where UIKit hands back a touch
+// whose previously estimated properties are now final. Only the pressure is
+// re-sent: position/tilt on this callback describe the ORIGINAL event, which was
+// already reported, and re-sending them would rewind the pen.
+void UIKit_HandlePenEstimatedPressure(SDL_uikitview *view, UITouch *pencil)
+{
+    const SDL_PenID penId = UIKit_AddPenIfNecesary();
+    if (penId) {
+        const float maxForce = (float) [pencil maximumPossibleForce];
+        if (maxForce > 0.0f) {
+            SDL_SendPenAxis(UIKit_GetEventTimestamp([pencil timestamp]), penId, [view getSDLWindow],
+                            SDL_PEN_AXIS_PRESSURE, ((float) [pencil force]) / maxForce);
+        }
+    }
+}
