+// UIKit reports UITouch.force as an ESTIMATE for the first few events of a pen
+// contact and calls back here once the real value is known. SDL_uikitpen.m
+// withholds the estimate entirely, so this callback is the ONLY place a pen's
+// opening pressure is ever reported.
+- (void)touchesEstimatedPropertiesUpdated:(NSSet<UITouch *> *)touches
+{
+#if !defined(SDL_PLATFORM_TVOS)
+    if (@available(iOS 13.0, *)) {
+        for (UITouch *touch in touches) {
+            if (touch.type == UITouchTypePencil) {
+                UIKit_HandlePenEstimatedPressure(self, touch);
+            }
+        }
+    }
+#endif
+}
